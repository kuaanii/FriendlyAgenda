{
  "name": "friendly-agenda",
  "version": "0.5.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kuaanii/FriendlyAgenda.git"
  },
  "description": "Tu agenda de papel, en digital. Privada y local.",
  "author": "FriendlyAgenda contributors",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "start": "electron .",
    "pack": "vite build && electron-builder --win portable --x64 --publish never",
    "test:ui": "playwright test",
    "format:check": "prettier --check src electron tests build/*.cjs *.js *.json",
    "test:desktop": "node --test tests/desktop/*.test.js",
    "audit:publication": "node scripts/audit-publication.cjs",
    "pack:win": "vite build && electron-builder --win portable --x64 --publish never",
    "pack:mac": "vite build && electron-builder --mac dmg --publish never"
  },
  "build": {
    "appId": "org.friendlyagenda.desktop",
    "productName": "FriendlyAgenda",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/model.js",
      "package.json",
      "build/icon.png",
      "src/i18n.js",
      "src/locales/*.json",
      "src/entries.js",
      "build/trayTemplate*.png"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": true,
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "FriendlyAgenda-${version}-Windows.exe"
    },
    "electronDist": "node_modules/electron/dist",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "artifactName": "FriendlyAgenda-${version}-macOS-${arch}.dmg"
    },
    "dmg": {
      "title": "FriendlyAgenda ${version}",
      "contents": [
        {
          "x": 150,
          "y": 180,
          "type": "file"
        },
        {
          "x": 430,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.61.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "node-ical": "^0.27.3"
  }
}
